{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Efficient Attention Markdown document v1",
  "type": "object",
  "required": ["schema_version", "document_id", "root_prefix", "nodes", "groups", "stats"],
  "properties": {
    "schema_version": {"const": 1},
    "document_id": {"type": "string", "minLength": 1},
    "root_prefix": {"type": "string"},
    "nodes": {
      "type": "array", "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "path", "parent", "node_type", "text", "tokens", "positions", "seq_ids", "merged_into"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "parent": {"type": ["string", "null"]},
          "node_type": {"enum": ["document", "section", "heading", "list", "list_item", "code"]},
          "text": {"type": "string"},
          "tokens": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "positions": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "seq_ids": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 255}}},
          "merged_into": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array", "minItems": 2, "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["seq_id", "path", "node_id", "start_pos", "end_pos"],
        "properties": {
          "seq_id": {"type": "integer", "minimum": 0, "maximum": 255},
          "path": {"type": "string"},
          "node_id": {"type": "string"},
          "start_pos": {"type": "integer", "minimum": 0},
          "end_pos": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "stats": {"type": "object"}
  },
  "additionalProperties": false
}
